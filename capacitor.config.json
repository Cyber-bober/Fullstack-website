{
  "appId": "com.company.football",
  "appName": "Football App",
  "webDir": "public",
  "bundledWebRuntime": false,
  "server": {
    "url": "http://192.168.0.152:3000",
    "cleartext": true,
    "androidScheme": "http",
    "allowNavigation": [
      "*"
    ]
  },
  "android": {
    "allowMixedContent": true,
    "minSdkVersion": 24,
    "targetSdkVersion": 34
  },
  "plugins": {
    "Network": {
      "allowCleartext": true
    },
    "CapacitorHttp": {
      "enabled": true
    }
  }
}
