generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(uuid())
  username          String    @unique
  passwordHash      String
  fullName          String
  birthDate         DateTime?
  city              String?
  role              String    @default("USER")
  position          String?
  photos            String[]
  contacts          String?
  stats             String?
  teamId            String?
  privacyAcceptedAt DateTime?

  team         Team?         @relation(fields: [teamId], references: [id])
  captainOf    Team?         @relation("TeamCaptain")
  newsPosts    NewsPost[]
  sentMessages ChatMessage[] @relation("Sender")
  recvMessages ChatMessage[] @relation("Receiver")
  roleRequests RoleRequest[]

  supportTickets  SupportTicket[]
  supportMessages SupportMessage[]

  createdAt DateTime @default(now())

  @@index([role])                          // Поиск по роли (админы, редакторы)
  @@index([teamId])                        // Поиск игроков команды
  @@index([createdAt])                     // Сортировка по дате
  @@index([role, createdAt])               // Составной: админы по дате
  @@index([fullName])                      // Поиск по имени
}

model Team {
  id          String   @id @default(uuid())
  name        String
  logoUrl     String?
  photos      String[]
  captainId   String?  @unique
  captain     User?    @relation("TeamCaptain", fields: [captainId], references: [id])
  stats       String?
  rating      Int      @default(1500)
  players     User[]
  homeMatches Match[]  @relation("HomeTeam")
  awayMatches Match[]  @relation("AwayTeam")
  createdAt   DateTime @default(now())

  @@index([rating])
  @@index([name])
  @@index([rating, name])
}

model Match {
  id         String       @id @default(uuid())
  homeTeamId String
  awayTeamId String
  date       DateTime
  status     String       @default("SCHEDULED")
  score      String?
  stats      String?
  venue      String?
  homeTeam   Team         @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam   Team         @relation("AwayTeam", fields: [awayTeamId], references: [id])
  events     MatchEvent[]
  createdAt  DateTime     @default(now())

  @@index([date])                        // Сортировка по дате
  @@index([status])                      // Фильтр по статусу
  @@index([date, status])                // Составной: дата + статус
  @@index([homeTeamId, date])            // Матчи команды по дате
  @@index([awayTeamId, date])            // Матчи команды по дате
  @@index([homeTeamId, awayTeamId])      // Поиск матчей между командами
}

model NewsPost {
  id          String   @id @default(uuid())
  authorId    String
  title       String
  content     String
  category    String   @default("GENERAL")
  imageUrl    String?
  matchId     String?
  isPublished Boolean  @default(false)
  author      User     @relation(fields: [authorId], references: [id])
  createdAt   DateTime @default(now())

  @@index([isPublished, createdAt])      // Опубликованные новости по дате
  @@index([authorId, createdAt])         // Новости автора
  @@index([category, isPublished])       // Новости по категории
  @@index([title])                       // Поиск по заголовку
}

model ChatMessage {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  text       String
  fileUrl    String?
  isRead     Boolean  @default(false)
  isPinned   Boolean  @default(false)
  sender     User     @relation("Sender", fields: [senderId], references: [id])
  receiver   User     @relation("Receiver", fields: [receiverId], references: [id])
  createdAt  DateTime @default(now())

  @@index([senderId, createdAt])         // Сообщения отправителя
  @@index([receiverId, createdAt])       // Сообщения получателя
  @@index([senderId, receiverId, createdAt])  // Диалог между двумя
  @@index([isRead])                      // Непрочитанные сообщения
}

model RoleRequest {
  id            String   @id @default(uuid())
  userId        String
  requestedRole String
  status        String   @default("PENDING")
  user          User     @relation(fields: [userId], references: [id])
  createdAt     DateTime @default(now())

  @@index([userId, status])              // Запросы пользователя
  @@index([status, createdAt])           // Запросы по статусу
}

model MatchEvent {
  id        String   @id @default(uuid())
  matchId   String
  minute    Int?
  text      String
  createdAt DateTime @default(now())
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([matchId, createdAt])          // События матча по времени
  @@index([matchId, minute])             // События матча по минуте
}

model SupportTicket {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  subject   String
  status    String   @default("OPEN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages SupportMessage[]

  @@index([userId, createdAt])           // Тикеты пользователя
  @@index([status, createdAt])           // Тикеты по статусу
}

model SupportMessage {
  id        String        @id @default(uuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User          @relation(fields: [senderId], references: [id])
  text      String
  isAdmin   Boolean       @default(false)
  createdAt DateTime      @default(now())

  @@index([ticketId, createdAt])         // Сообщения тикета
  @@index([senderId])                    // Сообщения отправителя
}

model LiveStream {
  id          String   @id @default(uuid())
  title       String   @default("Прямая трансляция")
  vkVideoUrl  String
  vkGroupUrl  String
  tgGroupUrl  String
  isActive    Boolean  @default(true)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([isActive])                    // Активные трансляции
}